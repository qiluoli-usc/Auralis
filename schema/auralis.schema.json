{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuralisPatch",
  "type": "object",
  "properties": {
    "oscillators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "waveform": {
            "type": "string",
            "enum": ["sine", "saw", "square", "triangle", "noise"]
          },
          "detune_cents": {
            "type": "number",
            "minimum": -100,
            "maximum": 100,
            "default": 0
          },
          "semi_offset": {
            "type": "integer",
            "minimum": -24,
            "maximum": 24,
            "default": 0
          },
          "level": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 1
          }
        },
        "required": ["waveform", "level"],
        "additionalProperties": false
      }
    },
    "filter": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["lp", "hp", "bp", "ladder_lp"]
        },
        "cutoff_hz": {
          "type": "number",
          "minimum": 20,
          "maximum": 20000,
          "default": 1000
        },
        "resonance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1
        },
        "drive": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        }
      },
      "required": ["type", "cutoff_hz", "resonance"],
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "properties": {
        "amp": {
          "type": "object",
          "properties": {
            "attack_ms": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000,
              "default": 5
            },
            "decay_ms": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000,
              "default": 200
            },
            "sustain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.7
            },
            "release_ms": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000,
              "default": 300
            }
          },
          "required": ["attack_ms", "decay_ms", "sustain", "release_ms"],
          "additionalProperties": false
        }
      },
      "required": ["amp"],
      "additionalProperties": false
    },
    "lfo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rate_hz": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 30
          },
          "shape": {
            "type": "string",
            "enum": ["sine", "triangle", "saw", "square", "random"]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "param": {"type": "string"},
                "depth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["param", "depth"],
              "additionalProperties": false
            }
          }
        },
        "required": ["rate_hz", "shape"],
        "additionalProperties": false
      }
    },
    "fx": {
      "type": "object",
      "properties": {
        "reverb": {
          "type": "object",
          "properties": {
            "mix": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            }
          },
          "additionalProperties": false
        },
        "chorus": {
          "type": "object",
          "additionalProperties": true
        },
        "delay": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "bpm": {
          "type": "integer",
          "minimum": 20,
          "maximum": 300
        },
        "seed": {"type": "integer"},
        "model": {"type": "string"},
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["oscillators", "filter", "env"],
  "additionalProperties": false
}
