{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuralisPatch",
  "type": "object",
  "required": ["name", "oscillators", "envelope"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for the patch"
    },
    "oscillators": {
      "type": "array",
      "description": "Ordered list of oscillator settings",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["wavetable", "blend"],
        "properties": {
          "wavetable": {
            "type": "string",
            "description": "Name or identifier of the wavetable"
          },
          "octave": {
            "type": "integer",
            "default": 0
          },
          "detune": {
            "type": "number",
            "default": 0
          },
          "blend": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Mix level between oscillator and dry signal"
          }
        },
        "additionalProperties": false
      }
    },
    "envelope": {
      "type": "object",
      "required": ["attack", "decay", "sustain", "release"],
      "properties": {
        "attack": {"type": "number", "minimum": 0},
        "decay": {"type": "number", "minimum": 0},
        "sustain": {"type": "number", "minimum": 0, "maximum": 1},
        "release": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string",
      "description": "Free-form notes about how the patch was generated"
    }
  },
  "additionalProperties": false
}
